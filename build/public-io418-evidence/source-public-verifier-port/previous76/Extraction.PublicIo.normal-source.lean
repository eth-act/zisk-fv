theorem publicEmissions_linked (i : Fin publicEmissions.length) :
  let e := publicEmissions[i]
  normalize (sourceDenominators[e.termIndex]!) = .add (mix e.bus (.challenge 2 0) e.slots) (.challenge 2 1) ∧
  flattenMul (sourceTerms[e.termIndex]!) = sourceDenominators.eraseIdx e.termIndex := by
  fin_cases i <;> constructor <;> rfl

def denominatorBus (e : Expr) : Option Nat :=
  match normalize e with
  | .add (.add _ (.constant bus)) (.challenge 2 1) => some bus
  | .add (.constant bus) (.challenge 2 1) => some bus
  | _ => none

def sourceOperationTermIndices : List Nat :=
  sourceDenominators.zipIdx.filterMap fun p =>
    if denominatorBus p.1 = some 5000 then some p.2 else none

theorem source_denominator_bus_complete :
  none ∉ sourceDenominators.map denominatorBus := by decide

theorem source_operation_emissions_complete :
  sourceOperationTermIndices = publicEmissions.map Emission.termIndex := by decide

end Extraction.PublicIo
