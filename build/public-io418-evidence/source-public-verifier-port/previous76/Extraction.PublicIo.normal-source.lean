  | neg : Expr → Expr
  deriving DecidableEq, Repr, Inhabited

def flattenAdd : Expr → List Expr
  | .add a b => flattenAdd a ++ flattenAdd b
  | e => [e]
def flattenMul : Expr → List Expr
  | .mul a b => flattenMul a ++ flattenMul b
  | e => [e]
def normalize : Expr → Expr
  | .add a b => match normalize a, normalize b with
    | .constant 0, b => b
    | a, .constant 0 => a
    | a, b => .add a b
  | .mul a b => match normalize a, normalize b with
    | .constant 0, _ => .constant 0
    | _, .constant 0 => .constant 0
    | a, b => .mul a b
  | .sub a b => .sub (normalize a) (normalize b)
  | .neg a => .neg (normalize a)
  | e => e
def mix (bus alpha : Expr) (slots : List Expr) : Expr :=
  normalize (.add (.mul (slots.foldr (fun slot acc => .add (.mul acc alpha) slot) (.constant 0)) alpha) bus)

