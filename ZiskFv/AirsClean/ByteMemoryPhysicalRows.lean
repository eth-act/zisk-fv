import ZiskFv.AirsClean.ByteMemorySourceOperations
import Extraction.SourceDimensions
import Init.Data.Array.Lemmas

/-!
INTERNAL partial native-buffer physical domain, not an Accepted validator.
The constructor reads one actual registry-selected setup and final slot, checks
full native-buffer coverage (allowing the original shared-buffer suffix), and
scans the ACTUAL fixed buffer for first-row1/remaining-row0 without constructing
an N-element row list or copied trace. Native metadata stride and logical cm1
stride are retained separately; packed rows are never decoded as logical cells.

GenericTrace::new_from_vec (locked ff0 common/src/trace.rs129–164) requires
buffer.len >= NUM_ROWS * R::ROW_SIZE; get_buffer175–194 preserves original
shared length, and Trace235–274 supplies native ROW_SIZE/isPacked. The source
traces.rs344–359,388–392 and current PIL dimensions give these two read-capable AIR domains.
This checked descriptor is NOT the missing trace!-AST/materialization proof,
setup/PIL authentication, packed logical decoding, native machine/ABI theorem,
source-fixed producer authentication, or accepted physical coverage. Constructor
failure is NOT a Root exclusion. No padding scalar/count relation is introduced.
-/
namespace ZiskFv.AirsClean.ByteMemoryPhysicalRows

open Goldilocks
open ZiskFv.AirsClean.MemAlignWriteByte.RawSource
open ZiskFv.AirsClean.MemAlignWriteByte.RawSource.Native

inductive Air where
  | byte | readByte
  deriving DecidableEq

def Air.pilRows : Air → Nat
  | .byte => Extraction.SourceDimensions.MemAlignByte.rowCount
  | .readByte => Extraction.SourceDimensions.MemAlignReadByte.rowCount

def Air.logicalWidth : Air → Nat
  | .byte => 16 | .readByte => 10

def Air.schema : Air → Extraction.LookupWiring.SourceSchema.Air
  | .byte => Extraction.LookupWiring.SourceSchema.air_MemAlignByte
  | .readByte => Extraction.LookupWiring.SourceSchema.air_MemAlignReadByte

/-- PIL logical cells are counted independently of native row packing. -/
def logicalCells (air : Air) : Nat :=
  (air.schema.symbols.filter (fun symbol =>
    symbol.kind == .witness && symbol.stage == some 1)).foldl
      (fun width symbol => width + symbol.lengths.prod) 0

theorem actual_logical_width (air : Air) : logicalCells air = air.logicalWidth := by
  cases air <;> rfl

theorem actual_l1_symbol (air : Air) :
    air.schema.symbols.filter (fun symbol => symbol.kind == .fixed) =
      [⟨some 0, some air.schema.airIndex, "__L1__", .fixed, some 0, 0, 0, []⟩] := by
  cases air <;> rfl

def Air.airId : Air → Nat
  | .byte => 18 | .readByte => 19

def airForEntry? (entry : RegistryEntry) : Option Air :=
  if entry.airgroupId = 0 ∧ entry.airId = 18 then some .byte
  else if entry.airgroupId = 0 ∧ entry.airId = 19 then some .readByte
  else none

theorem registry_scope {entry : RegistryEntry} {air : Air}
    (h : airForEntry? entry = some air) :
    entry.airgroupId = 0 ∧ entry.airId = air.airId := by
  unfold airForEntry? at h
  split_ifs at h <;> simp_all [Air.airId]
  all_goals cases h <;> rfl

/-- These capacities are source compiler data, not populated-prefix lengths. -/
theorem actual_physical_capacity (air : Air) : air.pilRows = 4194304 := by
  cases air <;> rfl

def Air.paddingAir : Air → ZiskFv.AirsClean.NativeValuesLayout.PaddingAir
  | .byte => .byte | .readByte => .readByte

variable {source : SourceObject FGL}

/-- Numeric/profile agreement is CHECKED on the actual selected data. It is not
an assumption that source-object setup or slot metadata is authenticated.
The fixed scan visits the bounded native fixed prefix directly, no slice copy. -/
def Supported (resolved : ResolvedOccurrence source) (air : Air)
    (setup : NativeSetup) (cm1 : Nat) : Prop :=
  setup.profile.verify = false ∧ setup.profile.gpu = false ∧
  setup.rowCount = air.pilRows ∧ cm1 = air.logicalWidth ∧
  0 < resolved.slotData.metadata.nColsTrace ∧
  (resolved.slotData.metadata.isPacked = false →
    resolved.slotData.metadata.nColsTrace = cm1) ∧
  setup.rowCount * resolved.slotData.metadata.nColsTrace ≤ resolved.slotData.trace.size ∧
  setup.nConstants = 1 ∧ setup.rowCount ≤ resolved.slotData.fixed.size ∧
  resolved.slotData.fixed[0]? = some 1 ∧
  resolved.slotData.fixed.all (fun value => value == 0) 1 setup.rowCount = true

instance (resolved : ResolvedOccurrence source) (air : Air) (setup : NativeSetup) (cm1 : Nat) :
    Decidable (Supported resolved air setup cm1) := by
  unfold Supported
  infer_instance

/-- All proof fields are generated by `fromResolved?` from this same source.
There is no arbitrary row list, native width, padding value or once roster. -/
structure Rows (resolved : ResolvedOccurrence source) where
  air : Air
  registrySelected : airForEntry? resolved.registryEntry = some air
  setup : NativeSetup
  setupSelected : resolved.setup? = some setup
  cm1 : Nat
  cm1Selected : setup.mapSectionsN["cm1"]? = some cm1
  supported : Supported resolved air setup cm1
  padding : FGL
  paddingSelected :
    ZiskFv.AirsClean.NativeValuesLayout.paddingValue? air.paddingAir (resolved.params false) =
      some padding

def fromResolved? (resolved : ResolvedOccurrence source) : Option (Rows resolved) := do
  match hair : airForEntry? resolved.registryEntry with
  | none => none
  | some air =>
    match hsetup : resolved.setup? with
    | none => none
    | some setup =>
      match hcm1 : setup.mapSectionsN["cm1"]? with
      | none => none
      | some cm1 =>
        match hpadding :
            ZiskFv.AirsClean.NativeValuesLayout.paddingValue? air.paddingAir (resolved.params false) with
        | none => none
        | some padding =>
          if h : Supported resolved air setup cm1 then
            some ⟨air, hair, setup, hsetup, cm1, hcm1, h, padding, hpadding⟩
          else none

/-- Completeness of the partial checked constructor on its own descriptor
domain, not a native materialization/Accepted-domain existence claim. -/
theorem constructor_recovers {resolved : ResolvedOccurrence source} (view : Rows resolved) :
    fromResolved? resolved = some view := by
  cases view with
  | mk air hair setup hsetup cm1 hcm1 hsupported padding hpadding =>
    unfold fromResolved?
    split
    · rename_i hnone
      simp [hair] at hnone
    · rename_i selectedAir hselectedAir
      have heq := Option.some.inj (hselectedAir.symm.trans hair)
      subst selectedAir
      split
      · rename_i hnone
        simp [hsetup] at hnone
      · rename_i selectedSetup hselectedSetup
        have heq := Option.some.inj (hselectedSetup.symm.trans hsetup)
        subst selectedSetup
        split
        · rename_i hnone
          simp [hcm1] at hnone
        · rename_i selectedCm1 hselectedCm1
          have heq := Option.some.inj (hselectedCm1.symm.trans hcm1)
          subst selectedCm1
          split
          · rename_i hnone
            simp [hpadding] at hnone
          · rename_i selectedPadding hselectedPadding
            have heq := Option.some.inj (hselectedPadding.symm.trans hpadding)
            subst selectedPadding
            split
            · rfl
            · contradiction

namespace Rows

variable {resolved : ResolvedOccurrence source}

def count (view : Rows resolved) : Nat := view.setup.rowCount
abbrev Index (view : Rows resolved) := Fin view.count

def nativeStride (_view : Rows resolved) : Nat := resolved.slotData.metadata.nColsTrace

theorem count_pos (view : Rows resolved) : 0 < view.count := by
  change 0 < view.setup.rowCount
  rw [view.supported.2.2.1, actual_physical_capacity]
  decide

theorem trace_coverage (view : Rows resolved) :
    view.count * view.nativeStride ≤ resolved.slotData.trace.size := by
  rcases view.supported with ⟨_, _, _, _, _, _, hcoverage, _⟩
  exact hcoverage

theorem count_matches_pil (view : Rows resolved) : view.count = view.air.pilRows := by
  rcases view.supported with ⟨_, _, hcount, _⟩
  exact hcount

/-- Native nonemptiness follows from checked full coverage/positive stride.
It is not added as an external nonempty-table premise. -/
theorem trace_nonempty (view : Rows resolved) : 0 < resolved.slotData.trace.size := by
  rcases view.supported with ⟨_, _, _, _, hstride, _⟩
  exact lt_of_lt_of_le (Nat.mul_pos view.count_pos hstride) view.trace_coverage

theorem fixed_coverage (view : Rows resolved) :
    view.count ≤ resolved.slotData.fixed.size := by
  rcases view.supported with ⟨_, _, _, _, _, _, _, _, hcoverage, _⟩
  exact hcoverage

/-- Lazy native row address into the ORIGINAL store. No N-row materialization. -/
def nativeAddress (view : Rows resolved) (row : view.Index)
    (column : Fin view.nativeStride) : Fin resolved.slotData.trace.size :=
  ⟨row.val * view.nativeStride + column.val, by
    have hrow : row.val + 1 ≤ view.count := by omega
    have hprefix := Nat.mul_le_mul_right view.nativeStride hrow
    have hcell : row.val * view.nativeStride + column.val <
        (row.val + 1) * view.nativeStride := by nlinarith [column.isLt]
    exact lt_of_lt_of_le hcell (le_trans hprefix view.trace_coverage)⟩

/-- This is a native word view, not a packed logical-column decoder. -/
def nativeWord (view : Rows resolved) (row : view.Index)
    (column : Fin view.nativeStride) :=
  resolved.slotData.trace[view.nativeAddress row column]

/-- Source L1 at native fixed column0; width1 is checked, not assumed. -/
def l1? (_view : Rows resolved) (row : _view.Index) : Option FGL :=
  resolved.slotData.fixed[row.val]?

theorem actual_l1 (view : Rows resolved) (row : view.Index) :
    view.l1? row = some (if row.val = 0 then 1 else 0) := by
  rcases view.supported with ⟨_, _, _, _, _, _, _, _, _, hfirst, htail⟩
  by_cases hz : row.val = 0
  · simpa [l1?, hz] using hfirst
  · have hbound : row.val < resolved.slotData.fixed.size :=
      lt_of_lt_of_le row.isLt view.fixed_coverage
    have hzero := Array.all_iff_forall.mp htail row.val hbound ⟨by omega, row.isLt⟩
    have hvalue : resolved.slotData.fixed[row.val] = 0 := by simpa using hzero
    simp [l1?, hz, hbound, hvalue]

def first (view : Rows resolved) : view.Index := ⟨0, view.count_pos⟩

theorem unique_actual_l1 (view : Rows resolved) :
    ∃! row : view.Index, view.l1? row = some 1 := by
  refine ⟨view.first, ?_, ?_⟩
  · simp [actual_l1, first]
  · intro row hrow
    have hz : row.val = 0 := by
      by_contra hn
      simpa [actual_l1, hn] using hrow
    apply Fin.ext
    exact hz

/-- Actual read-capable source packets retain raw p and both timestamp-zero
counterparts; no zero-multiplicity tuple is excluded. -/
def sourceOperations? (_view : Rows resolved) (env : Environment FGL) :
    Option (List (Interaction FGL)) :=
  ByteMemorySourceOperations.byteOperations? resolved env

/-- Missing padding is rejected by the constructor. Every present field p,
including zero/negative, is retained verbatim in both ordered operations. -/
theorem source_operations_present (view : Rows resolved) (env : Environment FGL) :
    view.sourceOperations? env = some (ByteMemoryCompiledPadding.byteValues view.padding env) := by
  have hscope := registry_scope view.registrySelected
  have hpadding := view.paddingSelected
  cases hair : view.air <;>
    simp [sourceOperations?, hair, Air.airId] at hscope ⊢
  all_goals
    simp [Air.paddingAir, hair] at hpadding
    simp [ByteMemorySourceOperations.byteOperations?,
      ZiskFv.AirsClean.MemAlignWriteByte.RawByteSource.airForEntry?,
      Extraction.LookupWiring.SourceSchema.air_MemAlignByte,
      Extraction.LookupWiring.SourceSchema.air_MemAlignReadByte,
      ByteMemoryPadding.readCapable, ByteMemoryPadding.nativePaddingAir, hscope.1, hscope.2, hpadding]

/-- Internal flat-L1 representation only, not an existing Table modification. -/
def packetAt? (view : Rows resolved) (row : view.Index) (env : Environment FGL) :
    Option (List (Interaction FGL)) := do
  let selector ← view.l1? row
  if selector = 1 then view.sourceOperations? env
  else if selector = 0 then some [] else none

theorem first_packet (view : Rows resolved) (env : Environment FGL) :
    view.packetAt? view.first env = view.sourceOperations? env := by
  simp [packetAt?, actual_l1, first]

theorem other_packets (view : Rows resolved) (row : view.Index)
    (hrow : row.val ≠ 0) (env : Environment FGL) :
    view.packetAt? row env = some [] := by
  simp [packetAt?, actual_l1, hrow]

def batchLength (_view : Rows resolved) : Nat := 2

theorem source_batch_length (view : Rows resolved) (env : Environment FGL) :
    (view.sourceOperations? env).map List.length = some view.batchLength := by
  rw [source_operations_present]
  simp [batchLength, ByteMemoryCompiledPadding.byte_compiled_length]

/-- Exactly one source-defined instance batch across the FULL lazy native
domain. Multiplicity p is not converted to Nat; p0 still keeps both ordered tuples. -/
theorem exactly_one_source_batch (view : Rows resolved) (env : Environment FGL) :
    ∃! row : view.Index,
      (view.packetAt? row env).map List.length = some view.batchLength := by
  refine ⟨view.first, ?_, ?_⟩
  · change (view.packetAt? view.first env).map List.length = some view.batchLength
    rw [first_packet]
    exact source_batch_length view env
  · intro row hrow
    have hz : row.val = 0 := by
      by_contra hn
      rw [other_packets view row hn] at hrow
      cases hair : view.air <;> simp [batchLength, hair] at hrow
    apply Fin.ext
    exact hz

def next (view : Rows resolved) (row : view.Index) : view.Index :=
  ⟨(row.val + 1) % view.count, Nat.mod_lt _ view.count_pos⟩

def last (view : Rows resolved) : view.Index :=
  ⟨view.count - 1, by have := view.count_pos; omega⟩

/-- The actual shifted L1 is enabled at the physical last row, not the last
populated prefix row. Full checked native coverage supplies this domain. -/
theorem shifted_actual_l1 (view : Rows resolved) (row : view.Index) :
    view.l1? (view.next row) = some (if row.val + 1 = view.count then 1 else 0) := by
  rw [actual_l1]
  by_cases hlast : row.val + 1 = view.count
  · simp [next, hlast]
  · have hlt : row.val + 1 < view.count := by omega
    simp [next, Nat.mod_eq_of_lt hlt, hlast]

theorem unique_shifted_l1 (view : Rows resolved) :
    ∃! row : view.Index, view.l1? (view.next row) = some 1 := by
  refine ⟨view.last, ?_, ?_⟩
  · have hn := view.count_pos
    simp [shifted_actual_l1, last, Nat.sub_add_cancel (by omega : 1 ≤ view.count)]
  · intro row hrow
    have hlast : row.val + 1 = view.count := by
      by_contra hn
      simpa [shifted_actual_l1, hn] using hrow
    apply Fin.ext
    simp only [last]
    omega


end Rows
end ZiskFv.AirsClean.ByteMemoryPhysicalRows
