namespace ZiskFv.AirsClean.NativeTraceRules
open Extraction.RuntimeNativeValuesLayout
private def i := Token.ident
private def p (text : String) := Token.punct text false
private def par (tokens : List Token) := Token.group "parenthesis" (Tokens.ofList tokens)
private def bra (tokens : List Token) := Token.group "brace" (Tokens.ofList tokens)
private def brk (tokens : List Token) := Token.group "bracket" (Tokens.ofList tokens)
private def hole (name : String) := [p "#", i name]
private def path (names : List String) :=
  (names.map (fun name => [i name])).intersperse [p ":", p ":"] |>.flatten
private def call (name : String) (args : List Token) := [i name, par args]
private def method (receiver : List Token) (name : String) (args : List Token := []) :=
  receiver ++ [p ".", i name, par args]
private def atWord (name : String) := [i "self", p ".", i "packed", brk (hole name)]
private def constMask (name holeName : String) :=
  [i "const", i name, p ":", i "u64", p "="] ++ hole holeName ++ [p ";"]
private def typedRaw (name : String) (value : List Token) :=
  [i "let", i name, p "="] ++ value ++ [p ";"]
private def maskExpression (width : String) :=
  [par [par [.literal "1u128", p "<", p "<", i width], p "-", .literal "1"], i "as", i "u64"]
private def quoteBlock (body : List Token) := [i "quote", p "!", bra body]
private def ty (name : String) (args : List Token := []) :=
  path ["BitType", name] ++ (if args = [] then [] else [par args])

set_option maxRecDepth 100000

private def containedGetter := [bra (
  constMask "MASK_BITS" "mask_bits" ++
  typedRaw "raw_value" ([par (atWord "word_start" ++ [p ">", p ">"] ++ hole "bit_start")] ++
    [p "&", i "MASK_BITS"]) ++ hole "getter_conversion")]
private def splitGetter := [bra (
  constMask "LOW_MASK" "low_mask" ++ constMask "HIGH_MASK" "high_mask" ++
  typedRaw "low" ([par (atWord "word_start" ++ [p ">", p ">"] ++ hole "bit_start")] ++ [p "&", i "LOW_MASK"]) ++
  typedRaw "high" (atWord "word_end" ++ [p "&", i "HIGH_MASK"]) ++
  typedRaw "raw_value" ([par ([i "high", p "<", p "<"] ++ hole "low_bits")] ++ [p "|", i "low"]) ++
  hole "getter_conversion")]
private def conversion :=
  [i "if", i "bit_width", p "=", p "=", .literal "1",
   bra (quoteBlock [i "raw_value", p "!", p "=", .literal "0"]), i "else",
   bra (quoteBlock ([i "raw_value", i "as"] ++ hole "rust_type"))]

def scalarRulesAccepted : Bool :=
  [("emit_contained_packed_accessor.getter", containedGetter),
   ("emit_contained_packed_accessor.mask_bits", maskExpression "bit_width"),
   ("emit_split_packed_accessor.getter", splitGetter),
   ("emit_split_packed_accessor.low_bits", [.literal "64", p "-", i "bit_start"]),
   ("emit_split_packed_accessor.high_bits", [i "bit_width", p "-", i "low_bits"]),
   ("emit_split_packed_accessor.low_mask", maskExpression "low_bits"),
   ("emit_split_packed_accessor.high_mask", maskExpression "high_bits"),
   ("scalar.contained.getter_conversion", conversion),
   ("scalar.split.getter_conversion", conversion), ("array.conversion", conversion)].all fun (name, expected) =>
    decide (PublicIoMainTraceLayout.fragmentTokens? name = some expected)

private def fieldTy := [p "&", i "f", p ".", i "ty"]
private def packedSum (generic : Bool) (measure : String) :=
  method (method (method (method [i "fields"] "iter") "filter"
    ([p "|", i "f", p "|"] ++ (if generic then [] else [p "!"]) ++ call "contains_generic" fieldTy))
    "map" ([p "|", i "f", p "|"] ++ call measure fieldTy)) "sum"
private def sourceDispatch :=
  [i "for", i "f", i "in"] ++ method [i "fields"] "iter" ++ [bra (
    [i "if"] ++ call "contains_generic" fieldTy ++ [bra (
      [i "if", p "!"] ++ call "is_array" fieldTy ++ [bra (
        call "add_generic_setter_getter"
          [p "&", i "f", p ".", i "name", p ",", p "&", i "mut", i "setter_getters"] ++ [p ";"])])]
    ++ [i "else", bra ([i "if"] ++ call "is_array" fieldTy ++ [bra (
      call "add_packed_array_setter_getter"
        [p "&", i "f", p ".", i "name", p ",", p "&", i "f", p ".", i "ty", p ",",
         p "&", i "mut", i "offset", p ",", p "&", i "mut", i "setter_getters"] ++ [p ";"]),
      i "else", bra (call "add_packed_setter_getter"
        [p "&", i "f", p ".", i "name", p ",", p "&", i "f", p ".", i "ty", p ",",
         p "&", i "mut", i "offset", p ",", p "&", i "mut", i "setter_getters"] ++ [p ";"])])])]

private def containsGeneric := [bra ([i "match", i "ty", bra (
  ty "Generic" ++ [p "=", p ">", i "true", p ","] ++
  ty "Array" [i "inner", p ",", i "_"] ++ [p "=", p ">"] ++ call "contains_generic" [i "inner"] ++
  [p ",", i "_", p "=", p ">", i "false", p ","])])]
private def totalBits := [bra ([i "match", i "ty", bra (
  ty "Bit" [i "n"] ++ [p "=", p ">", p "*", i "n", p ","] ++
  ty "Generic" ++ [p "=", p ">", .literal "0", p ","] ++
  ty "Array" [i "inner", p ",", i "len"] ++ [p "=", p ">"] ++
  call "compute_total_bits" [i "inner"] ++ [p "*", i "len", p ","])])]
private def isArray := [bra ([i "matches", p "!", par (
  [i "ty", p ","] ++ ty "Array" [i "_", p ",", i "_"])])]

private def collectDimensions := [bra (
  [i "let", i "mut", i "dims", p "=", i "vec", p "!", brk [], p ";",
   i "while", i "let"] ++ ty "Array" [i "inner", p ",", i "len"] ++ [p "=", i "ty", bra (
    method [i "dims"] "push" [p "*", i "len"] ++ [p ";", i "ty", p "=", i "inner", p ";"]),
   i "let", i "mut", i "accumulated_dims", p "=", i "vec", p "!",
   brk ([.literal "1", p ";"] ++ method [i "dims"] "len"), p ";",
   i "for", par [i "i", p ",", i "val"], i "in"] ++
  method (method (method [i "accumulated_dims"] "iter_mut") "enumerate") "take"
    (method [i "dims"] "len" ++ [p "-", .literal "1"]) ++ [bra (
    [i "for", i "dim", i "in"] ++ method (method [i "dims"] "iter") "skip" [i "i", p "+", .literal "1"] ++
    [bra [p "*", i "val", p "*", p "=", p "*", i "dim", p ";"]]),
   i "if", i "let", i "Some", par [i "last"], p "="] ++ method [i "dims"] "first" ++ [bra (
    [i "accumulated_dims", brk (method [i "dims"] "len" ++ [p "-", .literal "1"]),
     p "=", p "*", i "last", p ";"]),
   par (call "compute_total_bits" [i "ty"] ++ [p ",", i "dims", p ",", i "accumulated_dims"])])]

private def flattenIndex := [bra (
  [i "let", i "mut", i "expr", p "="] ++ quoteBlock [p "#", par [p "#", i "idents"], p "*"] ++ [p ";",
   i "let", i "mut", i "iter", p "="] ++
  method (method (method [i "idents"] "iter") "zip" (method [i "dims"] "iter")) "rev" ++ [p ";",
   i "if", i "let", i "Some", par [par [i "last_id", p ",", i "_"]], p "="] ++ method [i "iter"] "next" ++
  [bra ([i "expr", p "="] ++ quoteBlock (hole "last_id") ++ [p ";"]),
   i "for", par [i "id", p ",", i "dim"], i "in", i "iter", bra (
    [i "expr", p "="] ++ quoteBlock
      ([par (hole "id" ++ [p "*"] ++ hole "dim")] ++ [p "+"] ++ hole "expr") ++ [p ";"]), i "expr"])]

private def typeForBitwidth := [bra ([i "match", i "width", bra (
  [.literal "1", p "=", p ">"] ++ quoteBlock [i "bool"] ++ [p ",",
   .literal "2", p ".", p ".", p "=", .literal "8", p "=", p ">"] ++ quoteBlock [i "u8"] ++ [p ",",
   .literal "9", p ".", p ".", p "=", .literal "16", p "=", p ">"] ++ quoteBlock [i "u16"] ++ [p ",",
   .literal "17", p ".", p ".", p "=", .literal "32", p "=", p ">"] ++ quoteBlock [i "u32"] ++ [p ",",
   .literal "33", p ".", p ".", p "=", .literal "64", p "=", p ">"] ++ quoteBlock [i "u64"] ++ [p ",",
   i "_", p "=", p ">"] ++ quoteBlock [i "u128"] ++ [p ","])])]

private def scalarDispatch :=
  [i "if", i "word_start", p "=", p "=", i "word_end",
   bra (call "emit_contained_packed_accessor" [
     p "&", i "setter_name", p ",", p "&", i "getter_name", p ",",
     i "word_start", p ",", i "bit_width", p ",", i "bit_start", p ",", i "rust_type"]),
   i "else", bra (call "emit_split_packed_accessor" [
     p "&", i "setter_name", p ",", p "&", i "getter_name", p ",",
     i "word_start", p ",", i "word_end", p ",", i "bit_width", p ",",
     i "bit_start", p ",", i "rust_type"])]

private def runtimeIdents :=
  method (method (method (method [i "dims"] "iter") "enumerate") "map" [
    p "|", par [i "i", p ",", i "_"], p "|", i "format_ident", p "!",
    par [.literal "\"i{}\"", p ",", i "i"]]) "collect"

private def arrayGetterSignature :=
  [i "pub", i "fn"] ++ hole "getter_name" ++ [
    par ([p "&", i "self", p ",", p "#",
      par (hole "runtime_idents" ++ [p ":", i "usize"]), p ",", p "*"]),
    p "-", p ">"] ++ hole "rust_type"

private def unpackedField :=
  typedRaw "field_type" (call "generate_f_field_type" fieldTy) ++
  method [i "unpacked_fields"] "push"
    (quoteBlock ([i "pub"] ++ hole "name" ++ [p ":"] ++ hole "field_type")) ++ [p ";"]

private def unpackedDispatch :=
  [i "for", i "f", i "in"] ++ method [i "fields"] "iter" ++ [bra (
    typedRaw "name" [p "&", i "f", p ".", i "name"] ++
    [i "if"] ++ call "contains_generic" fieldTy ++
    [bra unpackedField, i "else", bra unpackedField])]

def layoutRulesAccepted : Bool :=
  [("packed_row_impl.packed_bits", packedSum false "compute_total_bits"),
   ("packed_row_impl.packed_words", method [i "packed_bits"] "div_ceil" [.literal "64"]),
   ("packed_row_impl.generic_field_count", packedSum true "calculate_generic_field_size"),
   ("packed_row_impl.total_row_size", [i "packed_words", p "+", i "generic_field_count"]),
   ("packed.offset.initial", [.literal "0usize"]), ("packed.dispatch", sourceDispatch),
   ("scalar.bit_width", call "compute_total_bits" [i "field_type"]),
   ("scalar.rust_type", call "type_for_bitwidth" [i "bit_width"]),
   ("scalar.dispatch", scalarDispatch),
   ("scalar.start", [p "*", i "offset"]),
   ("scalar.end", [p "*", i "offset", p "+", i "bit_width"]),
   ("scalar.offset_update", [p "*", i "offset", p "=", i "end", p ";"]),
   ("scalar.word_start", [i "start", p "/", .literal "64"]),
   ("scalar.word_end", [par [i "end", p "-", .literal "1"], p "/", .literal "64"]),
   ("scalar.bit_start", [i "start", p "%", .literal "64"]),
   ("array.dimensions", call "collect_dimensions" [i "field_type"]),
   ("array.total_len", method (method [i "dims"] "iter") "product"),
   ("array.base_offset", [p "*", i "offset"]),
   ("array.offset_update", [p "*", i "offset", p "+", p "=", i "bit_width", p "*", i "total_len", p ";"]),
   ("array.rust_type", call "type_for_bitwidth" [i "bit_width"]),
   ("array.runtime_idents", runtimeIdents),
   ("packed.array.getter.signature", arrayGetterSignature),
   ("unpacked.dispatch", unpackedDispatch),
   ("array.runtime_flat", call "flatten_index_expr" [p "&", i "runtime_idents", p ",", p "&", i "acc_dims"]),
   ("contains_generic.body", containsGeneric), ("compute_total_bits.body", totalBits),
   ("is_array.body", isArray), ("collect_dimensions.body", collectDimensions),
   ("flatten_index_expr.body", flattenIndex),
   ("type_for_bitwidth.body", typeForBitwidth)].all fun (name, expected) =>
    decide (PublicIoMainTraceLayout.fragmentTokens? name = some expected)

