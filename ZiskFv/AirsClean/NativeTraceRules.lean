def sourceConeAccepted : Bool := expectedSourceCone.all fun (name, expected) =>
  decide ((Extraction.RuntimeMainTraceLayout.sourceFragments.find? fun fragment =>
    fragment.name == name).map (fun fragment => fragment.tokens) = some expected)

/-- Finite type-AST interpretation for the actual four macro declarations.
This consumes the SAME existing AST, not Rust source text or a second parser.
Unknown field syntax is None; no generic/default-zero interpretation exists. -/
private inductive SourceFieldType where
  | bit (width : Nat)
  | array (element : SourceFieldType) (length : Nat)
  | generic

private def sourceContainsGeneric : SourceFieldType → Bool
  | .bit _ => false
  | .array element _ => sourceContainsGeneric element
  | .generic => true

/-- Finite decimal literal interpretation without the partial String.Slice
iterator behind String.toNat?. Every digit is interpreted; no width whitelist
or unsupported-literal fallback is introduced. -/
private def decimalLiteral? (text : String) : Option Nat :=
  if text.toList.isEmpty then none else
    text.toList.foldlM (fun value digit =>
      if '0' ≤ digit ∧ digit ≤ '9' then
        some (value * 10 + digit.toNat - '0'.toNat)
      else none) 0

private def scalarType? : List Token → Option (SourceFieldType × List Token)
  | .ident name :: rest =>
    match name with
    | "bit" => some (.bit 1, rest)
    | "u8" | "i8" => some (.bit 8, rest)
    | "u16" | "i16" => some (.bit 16, rest)
    | "u32" | "i32" => some (.bit 32, rest)
    | "u64" | "i64" => some (.bit 64, rest)
    | "ubit" | "ibit" => do
      let .group "parenthesis" count :: remaining := rest | none
      let [.literal text] := count.toList | none
      let width ← decimalLiteral? text
      if (if name == "ibit" then 2 else 1) ≤ width ∧ width ≤ 64 then
        some (.bit width, remaining)
      else none
    | _ => none
  | _ => none

private def fieldType? (tokens : List Token) :
    Option (SourceFieldType × List Token) :=
  match tokens with
  | .group "bracket" inner :: rest => do
    let (element, remainder) ← scalarType? inner.toList
    let [.punct ";" _, .literal text] := remainder | none
    let length ← decimalLiteral? text
    if 0 < length then some (.array element length, rest) else none
  | _ => scalarType? tokens

private def sourceFields? : Nat → List Token → Option (List (String × SourceFieldType))
  | _, [] => some []
  | 0, _ => none
  | fuel + 1, .ident name :: .punct ":" _ :: rest => do
    let (fieldType, remaining) ← fieldType? rest
    let tail ← match remaining with
      | [] => some []
      | .punct "," _ :: tail => some tail
      | _ => none
    let fields ← sourceFields? fuel tail
    some ((name, fieldType) :: fields)
  | _, _ => none

private def declarationBody? : List Token → Option Tokens
  | [.ident "trace_row", .punct "!" _, .group "parenthesis" inner] => some inner
  | [.ident "trace_row", .punct "!" _, .group "parenthesis" inner, .punct ";" _] => some inner
  | _ => none

private def declarationFields? (fragments : List SourceFragment) (name : String) :
    Option (List (String × SourceFieldType)) := do
  let fragment ← fragments.find? fun value => value.name == name
  let body ← declarationBody? fragment.tokens
  let [.ident actualName, .punct "<" _, .ident "F", .punct ">" _,
    .group "brace" fields] := body.toList | none
  if actualName == name then sourceFields? fields.toList.length fields.toList else none

/-- Every actual field is consumed, not just an assumed zero generic count.
The supported declaration syntax is exactly the actual known shapes;
nested/unknown syntax fails closed rather than silently excluding Root inputs. -/
def fourDeclarationsNonGeneric : Bool :=
  ["MainTraceRow", "BinaryTraceRow", "MemAlignByteTraceRow", "MemAlignReadByteTraceRow"].all fun name =>
    match declarationFields? Extraction.RuntimeMainTraceLayout.sourceFragments name with
    | none => false
    | some fields => !fields.isEmpty && fields.all fun (_, fieldType) =>
      !sourceContainsGeneric fieldType

/-- The same finite type-AST interpretation consumes the actual separate
companion declarations. No duplicate decoder, generic fallback, or free schema
is supplied by a caller; the companion independently pins complete source
declarations, aliases, coordinates, field order, widths and packed positions. -/
def twoDeclarationsNonGeneric : Bool :=
  ["MemTraceRow", "MemAlignWriteByteTraceRow"].all fun name =>
    match declarationFields? Extraction.RuntimeMemWriteByteTraceLayout.sourceFragments name with
    | none => false
    | some fields => !fields.isEmpty && fields.all fun (_, fieldType) =>
      !sourceContainsGeneric fieldType

def ready : Bool :=
  PublicIoMainTraceLayout.sourceRulesAccepted && scalarRulesAccepted && layoutRulesAccepted &&
    sourceConeAccepted && fourDeclarationsNonGeneric && twoDeclarationsNonGeneric &&
    PublicIoMemWriteByteTraceLayout.sourceDeclarationsAccepted

theorem actual_scalar_rules : scalarRulesAccepted = true := by decide +kernel

theorem actual_layout_rules : layoutRulesAccepted = true := by decide +kernel

theorem actual_source_cone : sourceConeAccepted = true := by decide +kernel

theorem actual_four_non_generic : fourDeclarationsNonGeneric = true := by decide +kernel

theorem actual_two_non_generic : twoDeclarationsNonGeneric = true := by decide +kernel

theorem actual_source_ready : ready = true := by
  simp only [ready, PublicIoMainTraceLayout.actual_source_rules, actual_scalar_rules,
    actual_layout_rules, actual_source_cone, actual_four_non_generic, actual_two_non_generic,
    PublicIoMemWriteByteTraceLayout.actual_source_declarations, Bool.and_self]

end ZiskFv.AirsClean.NativeTraceRules
