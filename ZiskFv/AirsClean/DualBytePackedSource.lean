import ZiskFv.AirsClean.PackedVirtualTableSources
import ZiskFv.AirsClean.DualByteSlice

/-! Intrinsic bus88 projection of the actual production packed provider.
The source-location map is generated by the production compiler observer;
the fixed tuple stream is checked against the actual packed-source checksum.
Only the actual raw multiplicity cell is writable. -/
namespace ZiskFv.AirsClean.DualBytePackedSource
open Goldilocks Air.Flat
open Extraction.PackedVirtualTables

/-- Domain transport from the logical source index to observed production metadata. -/
def sourceIndex (index : Fin 65536) : Fin source88.rows :=
  ⟨index.val, by simpa only [source88] using index.isLt⟩

def providerRow (raw : PackedVirtualTableSources.Witness FGL) (index : Fin 65536) :
    DualByteSlice.ProviderRow FGL :=
  DualByteSlice.sourceRows
    (fun i => PackedVirtualTableSources.project raw source88 (sourceIndex i)) index

/-- The multiplicity is the unchanged actual packed witness cell selected by
source88's compiler-observed AIR/lane/row location, not a caller-supplied count. -/
theorem providerRow_multiplicity (raw : PackedVirtualTableSources.Witness FGL)
    (index : Fin 65536) :
    (providerRow raw index).multiplicity = raw (source88.location (sourceIndex index)) := rfl

theorem providerRow_constructible (raw : PackedVirtualTableSources.Witness FGL)
    (index : Fin 65536) (data : ProverData FGL) (hint : ProverHint FGL) :
    DualByteSlice.circuit.ProverAssumptions (providerRow raw index) data hint := by
  exact DualByteSlice.sourceRows_membership _ index

/-- All source rows in their exact physical source order. Each projected raw row
contains only the actual unrestricted multiplicity witness. -/
def providerTable (raw : PackedVirtualTableSources.Witness FGL)
    (data : ProverData FGL) : Table FGL where
  component := DualByteSlice.sourceComponent
  rawRows := List.ofFn fun index : Fin 65536 => #[(providerRow raw index).multiplicity]
  data := data
  raw_uniform_width := by
    intro row hr
    simp only [List.mem_ofFn] at hr
    obtain ⟨index, rfl⟩ := hr
    rfl
  fixed_domain := by
    intro columns hcolumns
    have he : columns = DualByteSlice.sourceFixedColumns := Option.some.inj hcolumns.symm
    subst columns
    exact Nat.le_of_eq List.length_ofFn

theorem providerTable_materialized (raw : PackedVirtualTableSources.Witness FGL)
    (data : ProverData FGL) :
    (providerTable raw data).table =
      List.ofFn (fun index : Fin 65536 => (toElements (providerRow raw index)).toArray) := by
  have h_materialized : (providerTable raw data).table =
      (providerTable raw data).rawRows.mapIdx
        (fun index row => DualByteSlice.sourceFixedColumns.materialize index row) := by
    unfold Table.table
    rfl
  rw [h_materialized]
  dsimp only [providerTable]
  apply List.ext_getElem
  · simp only [List.length_mapIdx, List.length_ofFn]
  · intro index hi hi'
    have hindex : index < 65536 := by
      simpa only [List.length_mapIdx, List.length_ofFn] using hi
    simp only [List.getElem_mapIdx, List.getElem_ofFn]
    exact DualByteSlice.sourceFixedColumns_materialize
      ⟨index, hindex⟩ (providerRow raw ⟨index, hindex⟩).multiplicity

/-- Canonical provider constraints hold for every raw packed witness; the
fixed source index constructs membership instead of requesting an oracle. -/
theorem providerTable_constraints (raw : PackedVirtualTableSources.Witness FGL)
    (data : ProverData FGL) : (providerTable raw data).Constraints := by
  intro row hr
  rw [providerTable_materialized] at hr
  obtain ⟨index, rfl⟩ := List.mem_ofFn.mp hr
  exact DualByteSlice.source_constraints_fromInput (providerRow raw index) data
    (DualByteSlice.sourceRows_membership _ index)

def providerInteractions (raw : PackedVirtualTableSources.Witness FGL) :
    List (Interaction FGL) :=
  List.ofFn fun index : Fin 65536 =>
    ZiskFv.Channels.DualByte.DualByteChannel.pushedIfValue (providerRow raw index).multiplicity
      ⟨(providerRow raw index).byte_a, (providerRow raw index).byte_b⟩

theorem providerTable_interactionsWith (raw : PackedVirtualTableSources.Witness FGL)
    (data : ProverData FGL) :
    (providerTable raw data).interactionsWith
      ZiskFv.Channels.DualByte.DualByteChannel.toRaw = providerInteractions raw := by
  have hops := DualByteSlice.sourceComponent_interactionsWith
  change (providerTable raw data).component.operations.interactionsWith
    ZiskFv.Channels.DualByte.DualByteChannel.toRaw = _ at hops
  simp only [Table.interactionsWith, Operations.interactionValuesWith_eq_map,
    hops, List.map_singleton, ← List.map_eq_flatMap]
  rw [providerTable_materialized, List.map_ofFn]
  apply congrArg (fun f : Fin 65536 → Interaction FGL => List.ofFn f)
  funext index
  exact DualByteSlice.source_interaction_fromInput (providerRow raw index) data

/-- Raw-to-logical projection preserves arbitrary actual source multiplicities.
It imposes no histogram equality as an acceptance or soundness premise. -/
theorem projected_arbitrary_multiplicity
    (base : PackedVirtualTableSources.Witness FGL)
    (logical : PackedVirtualTableSources.LogicalWitness FGL) :
    PackedVirtualTableSources.project
      (PackedVirtualTableSources.physicalOfLogical base logical) source88 = logical.bus88 :=
  PackedVirtualTableSources.project88_physicalOfLogical base logical

end ZiskFv.AirsClean.DualBytePackedSource
