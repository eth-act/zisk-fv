/-- Recounting preserves the actual architectural instruction, including all
operand positions and retained pure-input immediates. -/
theorem recountSailInstruction {n q : Nat} (trace : AcceptedZiskTrace n)
    (room : q ≤ trace.mainTable.table.length) (enlarge : n ≤ q) (i : Fin n)
    (zs : ZiskStep trace i) :
    sailInstructionOf (recountIndex enlarge i) (recountStep trace room enlarge i zs) =
      sailInstructionOf i zs := by
  cases zs <;> rfl

/-- Recounting preserves the complete real execution/memory channel output.
For JALR the terminal physical row is retained, rather than using its start. -/
theorem recountChannelOutput {n q : Nat} (trace : AcceptedZiskTrace n)
    (room : q ≤ trace.mainTable.table.length) (enlarge : n ≤ q) (i : Fin n)
    (zs : ZiskStep trace i) (decode : RowDecode trace i zs) :
    stepChannelOutput (recountIndex enlarge i) (recountStep trace room enlarge i zs)
        (recountRowDecode trace room enlarge i zs decode) =
      stepChannelOutput i zs decode := by
  cases zs <;> rfl

/-- Raw-program evidence has no execution-count-dependent field beyond the
unchanged row value and Main table. Rebuild every raw record, preserving its
actual provider witnesses and all source-line correspondences. The JALR arm
retains its production-selected aligned/unaligned constructor and raw word. -/
def recountRawProgramDecode {n q rawLength : Nat} (trace : AcceptedZiskTrace n)
    (room : q ≤ trace.mainTable.table.length) (enlarge : n ≤ q) (i : Fin n)
    (zs : ZiskStep trace i)
    (start : Fin rawLength → Fin trace.programLength)
    (addr : Fin rawLength → FGL) (rawProgram : Fin rawLength → BitVec 32)
    (rawDecode : RawProgramDecode trace i zs start addr rawProgram) :
    RawProgramDecode (recountWithinMain trace q room) (recountIndex enlarge i)
      (recountStep trace room enlarge i zs) start addr rawProgram := by
  cases zs with
  | sub _ =>
      exact ⟨⟨{ h_idx := rawDecode.down.down.h_idx,
                 hLine := rawDecode.down.down.hLine }⟩⟩
  | and _ =>
      exact ⟨⟨{ h_idx := rawDecode.down.down.h_idx,
                 hLine := rawDecode.down.down.hLine }⟩⟩
  | or _ =>
      exact ⟨⟨{ h_idx := rawDecode.down.down.h_idx,
