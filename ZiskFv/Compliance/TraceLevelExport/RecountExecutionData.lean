/-- Retain the exact committed physical start and finish of a JALR lowering. -/
def recountJalrLoweringRows {n q : Nat} (trace : AcceptedZiskTrace n)
    (room : q ≤ trace.mainTable.table.length) (enlarge : n ≤ q) (i : Fin n)
    {imm : BitVec 12} {rs1 : regidx} {offset_bv : BitVec 64}
    (rows : JalrLoweringRows trace i imm rs1 offset_bv) :
    JalrLoweringRows (recountWithinMain trace q room) (recountIndex enlarge i)
      imm rs1 offset_bv where
  start := rows.start
  finish := rows.finish
  architectural_start := rows.architectural_start
  finish_has_successor := rows.finish_has_successor
  lowering := rows.lowering

