  | .srli c => .srli { r1 := c.r1, rd := c.rd, shamt := c.shamt }
  | .srai c => .srai { r1 := c.r1, rd := c.rd, shamt := c.shamt }
  | .add c => .add { r1 := c.r1, r2 := c.r2, rd := c.rd }
  | .addi c => .addi { r1 := c.r1, rd := c.rd, imm := c.imm }
  | .subw c => .subw { r1 := c.r1, r2 := c.r2, rd := c.rd }
  | .addw c => .addw { r1 := c.r1, r2 := c.r2, rd := c.rd }
  | .addiw c => .addiw { r1 := c.r1, rd := c.rd, imm := c.imm }
  | .sllw c => .sllw { r1 := c.r1, r2 := c.r2, rd := c.rd }
