import ZiskFv.Compliance.TraceLevelExport.PhysicalReplaySpine

/-!
# Concrete execution data under a Main-bounded recount

Only the finite execution count changes. Every claim is reconstructed by field
name, retaining all operands and retained pure inputs. Every decode is likewise
reconstructed with the same providers, offsets, pins, and physical JALR rows.
The generic count and Main-room bounds are supplied by the source-derived
construction; this module adds no execution-interface premise.
-/

set_option maxHeartbeats 8000000

namespace ZiskFv.Compliance.SerializedExecutionRows

open RawProgramBinding

/-- Include an old execution index in an enlarged finite execution domain. -/
def recountIndex {n q : Nat} (enlarge : n ≤ q) (i : Fin n) : Fin q :=
  ⟨i.val, Nat.lt_of_lt_of_le i.isLt enlarge⟩

@[simp] theorem recountIndex_val {n q : Nat} (enlarge : n ≤ q) (i : Fin n) :
    (recountIndex enlarge i).val = i.val := rfl

/-- Rebuild all 63 claim constructors without changing any claim field.
Ghost trace/index parameters change, but the actual decoded data does not. -/
def recountStep {n q : Nat} (trace : AcceptedZiskTrace n)
    (room : q ≤ trace.mainTable.table.length) (enlarge : n ≤ q) (i : Fin n) :
    ZiskStep trace i →
      ZiskStep (recountWithinMain trace q room) (recountIndex enlarge i)
  | .sub c => .sub { r1 := c.r1, r2 := c.r2, rd := c.rd }
  | .and c => .and { r1 := c.r1, r2 := c.r2, rd := c.rd }
  | .or c => .or { r1 := c.r1, r2 := c.r2, rd := c.rd }
  | .xor c => .xor { r1 := c.r1, r2 := c.r2, rd := c.rd }
  | .slt c => .slt { r1 := c.r1, r2 := c.r2, rd := c.rd }
  | .sltu c => .sltu { r1 := c.r1, r2 := c.r2, rd := c.rd }
  | .andi c => .andi { r1 := c.r1, rd := c.rd, imm := c.imm }
  | .ori c => .ori { r1 := c.r1, rd := c.rd, imm := c.imm }
  | .xori c => .xori { r1 := c.r1, rd := c.rd, imm := c.imm }
  | .slti c => .slti { r1 := c.r1, rd := c.rd, imm := c.imm }
  | .sltiu c => .sltiu { r1 := c.r1, rd := c.rd, imm := c.imm }
  | .sll c => .sll { r1 := c.r1, r2 := c.r2, rd := c.rd }
