@@ -34,9 +34,9 @@ constructions) is built relative to one of these.
 
 namespace ZiskFv.Compliance
 
-/-- Accepted committed trace for the full RV64IM Clean ensemble. -/
-structure AcceptedZiskTrace where
-  numInstructions : Nat
+/-- Accepted committed trace for the full RV64IM Clean ensemble, indexed by its
+    instruction count. -/
+structure AcceptedZiskTrace (numInstructions : Nat) where
   program : ZiskFv.AirsClean.ZiskInstructionRom.Program numInstructions
   witness :
     Air.Flat.EnsembleWitness
@@ -52,4 +52,10 @@ structure AcceptedZiskTrace where
           ZiskFv.AirsClean.Main.componentWithRomMemAndOpBus numInstructions program →
         ∀ i : Fin numInstructions, i.val < table.table.length
 
+/-- Recover the instruction count from a trace. `numInstructions` is now a
+    structure *parameter* (not a field), so this reducible accessor keeps the
+    pervasive `trace.numInstructions` dot-notation working and reducing to the
+    parameter. -/
+def AcceptedZiskTrace.numInstructions {n : Nat} (_ : AcceptedZiskTrace n) : Nat := n
+
 end ZiskFv.Compliance
