+/-- **Reduced (memory-map-only) load timeline residual** — the store-driven
+    Fold-B form of `LoadMemoryTimelineConstructionEvidence`.
+
+    This is the #76 step-(d) shrink target. Instead of the whole-`SailState`
+    `MemoryPrefixStateAlignment` identity (which pins `regs`/PC/`cycleCount`/…),
+    it carries:
+
+    * an opaque cursor-indexed Sail state assignment `stateAt` whose empty-prefix
+      value is the segment's initial Sail state and whose selected-prefix value is
+      the load `state`, with
+    * the **memory-map-only** named trace-coherence residual
+      `RowTraceCoherence` (`ZiskFv.ZiskCircuit.MemTimeline.Spike.RowTraceCoherence`)
+      over the consumed prefix.
+
+    `RowTraceCoherence` constrains only `.mem` at each cursor step; `regs`/PC are
+    free. It is strictly weaker than `MemoryPrefixStateAlignment` (see
+    `Spike.lean` §metric and the non-degenerate witness `witness_nondegenerate`,
+    which exhibits a load state whose `regs` *and* `cycleCount` differ from the
+    initial state — impossible under the frozen whole-state identity). It is the
+    documented external-trust trace-coherence residual (like channel-balance): a
+    named binder, NOT hidden, NOT derived here.
+
+    The byte-local agreement the load consumer actually needs is *derived* from
+    this residual via the Fold-B (`loadMemoryTimelineEvidence_of_coherenceEvidence`
+    below), so swapping the field to this form genuinely SHRINKS the residual. -/
+@[reducible]
+def LoadMemoryTimelineCoherenceEvidence
+    (state : PreSail.SequentialState RegisterType Sail.trivialChoiceSource)
+    (entry : Interaction.MemoryBusEntry FGL) : Prop :=
+  ∃ (initialState : ZiskFv.ZiskCircuit.MemTrace.SailState)
+    (rows : List (Interaction.MemoryBusEntry FGL))
+    (_facts : ZiskFv.AirsClean.Mem.GeneratedMemReplayFacts initialState rows)
+    (stateAt : List (Interaction.MemoryBusEntry FGL) → ZiskFv.ZiskCircuit.MemTrace.SailState)
+    (priorRows laterRows : List (Interaction.MemoryBusEntry FGL)),
+      rows = priorRows ++ entry :: laterRows
+        ∧ stateAt [] = initialState
+        ∧ state = stateAt priorRows
+        ∧ ZiskFv.ZiskCircuit.MemTimeline.Spike.RowTraceCoherence stateAt [] priorRows
+
+/-- **Fold-B derivation bridge (step (d)).** The reduced memory-map-only
+    `LoadMemoryTimelineCoherenceEvidence` *derives* the full
+    `MemoryTimelineEvidence` the load cores consume. The byte-local
+    `stateBytesAtPrefix` field is folded out of the per-store
+    `RowTraceCoherence` steps (via
+    `Spike.stateBytesAtPrefix_of_rowTraceCoherence`); the selected-read tag
+    fact comes from the load's `LoadStructuralPromises` (exactly as the legacy
+    whole-state route does, via `selectedRead_of_load_structural_promises`).
+    The whole-`SailState` `MemoryPrefixStateAlignment` identity is never used:
+    the load `state` stays opaque (`stateAt priorRows`).
+
+    This is the genuine Fold-B application: the byte agreement is transported out
+    of the per-store steps, never re-posited, so the residual strictly shrinks
+    from the whole-state identity to the memory-map-only coherence chain. -/
+theorem loadMemoryTimelineEvidence_of_coherenceEvidence
+    {state : PreSail.SequentialState RegisterType Sail.trivialChoiceSource}
+    {mstatus : RegisterType Register.mstatus}
+    {pmaRegion : PMA_Region}
+    {misa : RegisterType Register.misa}
+    {mseccfg : RegisterType Register.mseccfg}
+    {opcode_assumptions : Prop}
+    {pure_nextPC : BitVec 64}
+    {exec_row : List (Interaction.ExecutionBusEntry FGL)}
+    {e0 e1 e2 : Interaction.MemoryBusEntry FGL}
+    (promises :
+      ZiskFv.EquivCore.Promises.LoadStructuralPromises state mstatus pmaRegion
+        misa mseccfg opcode_assumptions pure_nextPC exec_row e0 e1 e2)
+    (h_coherence : LoadMemoryTimelineCoherenceEvidence state e1) :
+    Nonempty (ZiskFv.ZiskCircuit.MemTrace.MemoryTimelineEvidence state e1) := by
+  obtain ⟨initialState, rows, facts, stateAt, priorRows, laterRows,
+    h_traceSplit, h_seed, h_state, h_coh⟩ := h_coherence
+  subst h_state
+  refine ⟨?_⟩
+  exact
+    { acceptedReplay :=
+        ZiskFv.ZiskCircuit.MemTimeline.acceptedMemoryReplayEvidenceOfGeneratedReplayFacts facts
+      priorRows := priorRows
+      laterRows := laterRows
+      traceSplit := by
+        simpa
+          [ZiskFv.ZiskCircuit.MemTimeline.acceptedMemoryReplayEvidenceOfGeneratedReplayFacts]
+          using h_traceSplit
+      selectedRead :=
+        ZiskFv.ZiskCircuit.MemTimeline.selectedRead_of_load_structural_promises promises
+      stateBytesAtPrefix := by
+        simpa
+          [ZiskFv.ZiskCircuit.MemTimeline.acceptedMemoryReplayEvidenceOfGeneratedReplayFacts]
+          using
+            ZiskFv.ZiskCircuit.MemTimeline.Spike.stateBytesAtPrefix_of_rowTraceCoherence
+              (entry := e1) facts stateAt priorRows h_seed h_coh }
+
 /-- The construction-shaped load residual produces the legacy timeline evidence
     needed by existing load equivalence cores. -/
 theorem loadMemoryTimelineEvidence_of_constructionEvidence
