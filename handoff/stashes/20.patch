+/-! ## MemAlign-family load-provider projections
+
+These are the provider-side 6-slot memory-bus tuples for the
+sub-doubleword load channel. They mirror the extracted
+`bus_emission_MemAlign{,Byte,ReadByte}` specs verbatim; the semantic
+load pins (`wr = 0`, `is_write = 0`, `sel_prove = 1`, etc.) remain
+separate row-match hypotheses in `MemAlignBridge`.
+-/
+
+/-- General `MemAlign` provider projection for
+    `bus_emission_MemAlign_0`: `[wr + 1, addr * 8 + offset, step,
+    width, value[0], value[1]]`. -/
+@[simp]
+def memBus_row_MemAlign_load_provider
+    (v : Valid_MemAlign C F ExtF) (row : ℕ) : MemoryBusEntry6 F :=
+  { as := v.wr row + 1
+    ptr := v.addr row * 8 + v.offset row
+    mem_step := v.step row
+    bytes := v.width row
+    value_lo := v.value_0 row
+    value_hi := v.value_1 row }
+
+/-- `MemAlignByte` byte-load provider projection for
+    `bus_emission_MemAlignByte_2`: `[1 + is_write, main_addr, step,
+    1, bus_byte, 0]`. -/
+@[simp]
+def memBus_row_MemAlignByte_load_provider
+    (v : Valid_MemAlignByte C F ExtF) (row : ℕ) : MemoryBusEntry6 F :=
+  { as := 1 + v.is_write row
+    ptr := v.addr_w row * 8
+      + (v.sel_high_4b row * 4 + v.sel_high_2b row * 2) + v.sel_high_b row
+    mem_step := v.step row
+    bytes := 1
+    value_lo := v.bus_byte row
+    value_hi := 0 }
+
+/-- `MemAlignReadByte` byte-load provider projection for
+    `bus_emission_MemAlignReadByte_1`: `[1, main_addr, step, 1,
+    byte_value, 0]`. -/
+@[simp]
+def memBus_row_MemAlignReadByte_load_provider
+    (v : Valid_MemAlignReadByte C F ExtF) (row : ℕ) : MemoryBusEntry6 F :=
+  { as := 1
+    ptr := v.addr_w row * 8
+      + (v.sel_high_4b row * 4 + v.sel_high_2b row * 2) + v.sel_high_b row
+    mem_step := v.step row
+    bytes := 1
+    value_lo := v.byte_value row
+    value_hi := 0 }
+
 end ZiskFv.Airs.MemoryBus
